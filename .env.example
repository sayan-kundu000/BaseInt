# BaseInt Environment Configuration
# Copy this file to .env and customize values for your deployment

# Database Configuration (SQLite default; PostgreSQL example provided)
DATABASE_URL=sqlite:///./baseint_analytics.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/analytics_db

# LLM Provider Configuration
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# Execution & Safety Parameters
MAX_RETRIES=3
EXECUTION_TIMEOUT_SECONDS=15
AST_ENFORCE_READ_ONLY=true
NEMO_GUARDRAILS_ENABLED=true

# Server & Dashboard Ports
STREAMLIT_SERVER_PORT=8501
DOCS_SERVER_PORT=3000
BASE_URL=http://localhost:3000
